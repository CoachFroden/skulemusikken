rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /songs/{songId} {
      allow read, create, update, delete: if signedIn();
    }

    match /pdfEnhancementJobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == "queued"
        && request.resource.data.songId is string
        && request.resource.data.partId is string
        && request.resource.data.originalStoragePath is string;
      allow read: if signedIn()
        && resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false;
    }

    function isSkulemusikkenMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/apps/skulemusikken/members/$(request.auth.uid));
    }

    match /apps/skulemusikken/duties/{dutyId} {
      allow read, create, update, delete: if isSkulemusikkenMember();
    }

    match /apps/skulemusikken/settings/{docId} {
      allow read, create, update, delete: if isSkulemusikkenMember();
    }

    match /apps/skulemusikken/members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }
  }
}
