rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSkulemusikkenUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/apps/skulemusikken/members/$(request.auth.uid));
    }

    // Kun denne appens data. Andre samlinger i Firebase-prosjektet påvirkes ikke.
    match /apps/skulemusikken/duties/{dutyId} {
      allow read, write: if isSkulemusikkenUser();
    }

    match /apps/skulemusikken/settings/{docId} {
      allow read, write: if isSkulemusikkenUser();
    }

    match /apps/skulemusikken/members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // NB: Disse reglene dekker bare Skulemusikken-området. Hvis det eksisterende
    // Firebase-prosjektet allerede har andre Firestore-regler, må blokkene over
    // flettes inn i de eksisterende reglene i stedet for å erstatte hele regelsettet.
  }
}
